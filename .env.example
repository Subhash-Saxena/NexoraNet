# ==============================================================================
# NexoraNet - Environment Configuration Reference
# ==============================================================================
# Copy this file to '.env' and adjust variables for your target deployment environment.
# In production, never commit actual secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# ENVIRONMENT options: development, testing, staging, production
# In 'production', startup validation enforces that DEBUG=False, real PostgreSQL
# is configured, strong secrets (>=32 chars) are supplied, and CORS has no wildcards.
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER BINDING
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION & CONNECTION POOLING
# ------------------------------------------------------------------------------
# Local Development: SQLite (auto-created in backend directory)
DATABASE_URL=sqlite:///./nexoranet.db

# Production: PostgreSQL (Render, Neon, Supabase, AWS RDS, Docker Compose)
# Example: postgresql://nexora:your_strong_db_password@localhost:5432/nexoranet
# Note: legacy 'postgres://' URLs from cloud hosts are automatically normalized to 'postgresql://'
# DATABASE_URL=postgresql://nexora:secure_password@db:5432/nexoranet

# PostgreSQL Connection Pool Settings:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, wildcards ('*') and localhost entries are strictly rejected.
# Development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Production Example:
# CORS_ORIGINS=https://nexoranet.example.com,https://app.nexoranet.internal

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC SECRETS & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, generate a secure 64-char key: openssl rand -hex 32
SECRET_KEY=nexoranet-dev-secret-key-change-in-production-only
JWT_SECRET_KEY=nexoranet-dev-secret-key-change-in-production-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & BRUTE FORCE DEFENSE
# ------------------------------------------------------------------------------
# Maximum requests per client IP within a 60-second sliding window
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_FLAG_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 7. SECURITY HEADERS & DEFENSE-IN-DEPTH
# ------------------------------------------------------------------------------
STRICT_SECURITY_HEADERS=True

# ------------------------------------------------------------------------------
# 8. SIMULATION & VIRTUAL LAB BOUNDARIES (SAFETY INVARIANT)
# ------------------------------------------------------------------------------
# Virtual lab network CIDR strictly allowed for synthetic ping/scan simulations.
# External public IPs, WAN hosts, and unauthorized private subnets are blocked.
LAB_ALLOWED_SUBNET=10.99.0.0/16
